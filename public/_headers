# Cloudflare Pages headers. People type real passwords into /health, so scripts come only from this site (and
# Cloudflare's analytics beacon), and the only other host a page may talk to is Have I Been Pwned. Styles need
# 'unsafe-inline': Astro inlines the CSS, and each page sets its site's colours in a style attribute. The build fails
# when a page has an inline script this policy would block (src/integrations/csp-check.ts). The one hash allowed is the
# theme script in src/layouts/Base.astro, which has to run before the first paint.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-25N/Fgn1HiXVAloKcdfScyydrGHtAMQIfi0uoqaKOJA=' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.pwnedpasswords.com https://cloudflareinsights.com; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Only pass.azamatos.com should show up in search results, not Cloudflare's own addresses for the project.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
