---
import Banner from "@/components/Banner.astro";
import Generator from "@/components/Generator.astro";
import OtherSites from "@/components/OtherSites.astro";
import Rules from "@/components/Rules.astro";
import Trust from "@/components/Trust.astro";
import Icon from "@/components/ui/Icon.astro";
import { ANY } from "@/data/platforms";
import type { Platform } from "@/data/types";
import { bannerTags } from "@/lib/describe";

interface Props {
  /** Undefined for "Any site". */
  platform?: Platform;
}

const { platform } = Astro.props;
const site = platform ?? ANY;
---

<div class="wrap">
  <Banner
    eyebrow={platform ? "Password generator for" : "Password generator"}
    title={site.name}
    logo={site.id}
    tags={bannerTags(site.rules)}
  >
    {/* A link to the list of sites without JavaScript; src/scripts/header.ts opens the switcher instead. */}
    <a slot="action" class="change" href="#other-sites" aria-haspopup="dialog" data-sites-open>
      <Icon name="swap" size={18} />
      <span>Change site</span>
      <kbd class="keys">
        <span class="keys-mac">⌘K</span>
        <span class="keys-ctrl">Ctrl K</span>
      </kbd>
    </a>
  </Banner>
  <Generator id={site.id} site={site.name} rules={site.rules} anySite={!platform}>
    <Rules platform={platform} />
    <Trust />
  </Generator>
  <OtherSites current={site.id} />
</div>

<style>
  .change {
    display: inline-flex;
    grid-area: action;
    align-self: start;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 10px 0 18px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 13%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 30%, transparent);
    font-weight: 500;
  }

  .change:hover {
    background: color-mix(in srgb, currentColor 20%, transparent);
  }

  .change kbd {
    background: color-mix(in srgb, currentColor 16%, transparent);
    color: inherit;
  }

  @media (max-width: 700px) {
    .change {
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
    }

    .change kbd {
      display: none;
    }

    /* The icon alone; the words stay for screen readers. */
    .change span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }
</style>
