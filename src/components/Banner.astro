---
import Icon, { type IconName } from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";

/**
 * The page's banner in the site's colour (--brand): a white tile with the logo, the title, and under them the rule tags
 * or a line of text (the default slot). The logo also sits large and faint behind it all. "action" goes top right.
 */
interface Props {
  eyebrow: string;
  title: string;
  /** A site's id for its logo, or an icon for pages that aren't a site's. */
  logo?: string;
  icon?: IconName;
  tags?: string[];
  /** A smaller title, for pages with a sentence as their title. */
  long?: boolean;
}

const { eyebrow, title, logo, icon = "shield", tags = [], long = false } = Astro.props;
---

<section class:list={["banner", { long }]}>
  <span class="watermark" aria-hidden="true">
    {logo ? <Logo id={logo} eager /> : <Icon name={icon} size={400} weight={1.6} />}
  </span>
  <span class="tile" aria-hidden="true">
    {logo ? <Logo id={logo} eager /> : <Icon name={icon} size={46} weight={2.2} />}
  </span>
  <div class="name">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
  </div>
  <slot name="action" />
  {tags.length > 0 && (
    <ul class="tags" aria-label="Rules in short">
      {tags.map((tag) => {
        const symbols = /^Symbols (.+)$/.exec(tag);
        return (
          <li>
            {symbols ? (
              <>
                Symbols <span class="mono">{symbols[1]}</span>
              </>
            ) : (
              tag
            )}
          </li>
        );
      })}
    </ul>
  )}
  {Astro.slots.has("default") && (
    <p class="sub">
      <slot />
    </p>
  )}
</section>

<style>
  .banner {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-areas:
      "tile name action"
      "tags tags tags";
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 26px 28px;
    align-items: center;
    overflow: hidden;
    padding: 40px 44px 124px;
    border-radius: var(--radius-xl);
    background: var(--brand);
    color: var(--brand-ink);
  }

  .watermark {
    position: absolute;
    z-index: -1;
    top: -80px;
    right: -60px;
    width: 400px;
    height: 400px;
    opacity: 0.13;
    transform: rotate(-14deg);
  }

  .watermark :global(img),
  .watermark :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* A coloured logo turned into the banner's text colour: black, or white with --watermark-invert. */
  .watermark :global(img) {
    filter: brightness(0) invert(var(--watermark-invert));
  }

  .tile {
    display: grid;
    grid-area: tile;
    place-items: center;
    width: 88px;
    height: 88px;
    border-radius: 26px;
    background: #fff;
    color: var(--brand-ui-light);
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.06),
      0 12px 26px -12px rgba(0, 0, 0, 0.4);
  }

  .tile :global(img),
  .tile :global(svg) {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }

  .name {
    grid-area: name;
    min-width: 0;
  }

  .eyebrow {
    font-size: 18px;
    font-weight: 500;
    opacity: 0.88;
  }

  h1 {
    margin-top: 6px;
    font-size: 68px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    grid-area: tags;
    gap: 8px;
  }

  .tags li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 14%, transparent);
    font-size: 15px;
    font-weight: 500;
  }

  .mono {
    font-family: var(--font-mono);
  }

  .sub {
    grid-area: tags;
    max-width: 660px;
    font-size: 18px;
    text-wrap: pretty;
  }

  .long {
    grid-template-areas:
      "tile name"
      "tags tags";
    grid-template-columns: auto minmax(0, 1fr);
  }

  .long h1 {
    font-size: 56px;
  }

  @media (max-width: 700px) {
    .banner {
      gap: 14px;
      padding: 18px 18px 58px;
      border-radius: 26px;
    }

    .watermark {
      top: -30px;
      right: -60px;
      width: 230px;
      height: 230px;
    }

    .tile {
      width: 52px;
      height: 52px;
      border-radius: 16px;
    }

    .tile :global(img),
    .tile :global(svg) {
      width: 28px;
      height: 28px;
    }

    .eyebrow {
      font-size: 14px;
      line-height: 1.3;
    }

    h1 {
      margin-top: 2px;
      font-size: 34px;
    }

    .tags {
      gap: 6px;
    }

    .tags li {
      height: 28px;
      padding: 0 11px;
      font-size: 13.5px;
    }

    .sub {
      font-size: 15px;
    }

    .long h1 {
      font-size: 26px;
      line-height: 1.1;
      letter-spacing: -0.03em;
    }
  }
</style>
