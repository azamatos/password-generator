---
import { SITE } from "@/site";
---

<footer class="wrap">
  <div class="footer">
    <span class="wordmark" aria-hidden="true">
      <span class="arrow">➜</span>
      <span class="tilde">~</span>
      <span>pass.azamatos</span>
    </span>
    <nav aria-label="Footer">
      <a href="/">Generator</a>
      <a href="/health/">Health</a>
      <a href={SITE.author.url}>azamatos.com</a>
      <a href={SITE.repo}>Source on GitHub</a>
    </nav>
    <p class="fine">Free. Runs in your browser.</p>
    <p class="credits">
      Words: <a href="https://www.eff.org/dice">EFF</a> (CC BY 3.0) · Some rules:{" "}
      <a href="https://github.com/apple/password-manager-resources">Apple</a> (MIT)
    </p>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 56px;
    padding: 28px 0 40px;
    border-top: 1px solid var(--line);
  }

  .wordmark {
    display: inline-flex;
    gap: 0.55em;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .arrow {
    color: var(--sym);
  }

  .tilde {
    color: var(--muted);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 15px;
    color: var(--ink-2);
  }

  nav a {
    line-height: 24px;
  }

  nav a:hover {
    color: var(--ink);
  }

  .fine {
    margin-left: auto;
    font-size: 14px;
    color: var(--muted);
  }

  .credits {
    flex-basis: 100%;
    font-size: 13px;
    color: var(--muted);
  }

  .credits a {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 3px;
  }

  @media (max-width: 700px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
      margin-top: 40px;
    }

    .fine {
      margin-left: 0;
    }
  }
</style>
