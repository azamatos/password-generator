---
import { DEFAULT_SYMBOLS } from "@/lib/charsets";
import { MAX_WORDS, MIN_WORDS, SEPARATORS } from "@/lib/passphrase";
import { plan, type PasswordRules } from "@/lib/password";

interface Props {
  rules: PasswordRules;
  /** "GitHub", or "Any site". */
  site: string;
}

const { rules, site } = Astro.props;
// Same defaults as the script, so nothing jumps when it takes over.
const initial = plan(rules, {
  length: 16,
  classes: { lower: true, upper: true, digit: true, symbol: true },
  avoidAmbiguous: false,
});
const pct = (value: number, min: number, max: number) => `${max > min ? ((value - min) / (max - min)) * 100 : 0}%`;
const symbols = rules.symbols || DEFAULT_SYMBOLS;
const classes = [
  { name: "lower", label: "a–z", title: "Lowercase letters" },
  { name: "upper", label: "A–Z", title: "Uppercase letters" },
  { name: "digit", label: "0–9", title: "Numbers" },
  { name: "symbol", label: symbols.length > 6 ? symbols.slice(0, 4) : symbols, title: `Symbols: ${symbols}` },
] as const;
const separatorName: Record<string, string> = { "-": "Dash", ".": "Dot", _: "Underscore", " ": "Space", "": "None" };
const separatorLabel = (s: string) => (s === " " ? "space" : s === "" ? "none" : s);
const lockIcon = `<svg class="lock" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="7" width="9" height="6.5" rx="1.5"/><path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2"/></svg>`;
---

<div class="generator" data-generator data-rules={JSON.stringify(rules)} data-site={site}>
  <section class="card main" aria-label={`${site} password`}>
    <div class="top-row">
      <fieldset class="mode">
        <legend class="sr-only">Make a</legend>
        <label><input type="radio" name="mode" value="password" checked /><span>Password</span></label>
        <label><input type="radio" name="mode" value="passphrase" /><span>Passphrase</span></label>
      </fieldset>
      {/* Rendered up front so nothing shifts: generated passwords always meet the site's rules. */}
      <p class="meets" data-meets hidden={site === "Any site"}>
        <span class="ck" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"></path></svg></span>
        <span data-meets-text>Meets {site}'s rules</span>
      </p>
    </div>

    <div class="result" data-result>
      <output class="value" aria-label="Generated password" data-output>
        {/* Same width as the password, so the main content paints before the script runs and nothing moves when it does. */}
        <span class="placeholder" aria-hidden="true">{"•".repeat(initial.length)}</span>
        <noscript>Turn on JavaScript to generate a password.</noscript>
      </output>
      <div class="bars" aria-hidden="true" data-bars><i></i><i></i><i></i><i></i><i></i></div>
      <div class="foot">
        <p class="strength"><b data-level></b> <span data-details></span></p>
        <div class="actions">
          <button class="btn ghost" type="button" data-regenerate disabled>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7"></path><path d="M20 4v7h-7"></path></svg>
            New
          </button>
          <button class="btn brand" type="button" data-copy disabled>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
            <span data-copy-label>Copy</span>
          </button>
        </div>
      </div>
    </div>

    <div class="unsupported" data-unsupported hidden>
      <p data-unsupported-text></p>
      <button class="btn ghost" type="button" data-use-password>Use a password</button>
    </div>
    <p class="sr-only" role="status" data-status></p>
  </section>

  <div class="controls" data-panel="password">
    <section class="card ctl">
      <div class="ctl-head">
        <label class="label" for="length">Length</label>
        <output for="length" data-length-value>{initial.length}</output>
      </div>
      <input
        id="length"
        type="range"
        min={initial.minLength}
        max={initial.maxLength}
        value={initial.length}
        style={`--pct: ${pct(initial.length, initial.minLength, initial.maxLength)}`}
        data-length
      />
      <div class="hints">
        <span data-min>{initial.minLength}</span>
        <span>min</span>
        <span aria-hidden="true">·</span>
        <button type="button" class="rec" data-recommend>recommended</button>
        <span data-max>{initial.maxLength}</span>
      </div>
    </section>

    <fieldset class="card ctl">
      <legend class="label">Characters</legend>
      <div class="chips">
        {
          classes.map((c) => {
            const locked = initial.locked.includes(c.name);
            const unavailable = initial.unavailable.includes(c.name);
            return (
              <label
                class="chip"
                title={locked ? `${c.title}: required by ${site}` : c.title}
                data-chip={c.name}
                data-locked={locked ? "" : undefined}
              >
                <input type="checkbox" checked={!unavailable} disabled={locked || unavailable} data-class={c.name} />
                <span class="chip-face">
                  <Fragment set:html={lockIcon} />
                  <span aria-hidden="true">{c.label}</span>
                  <span class="sr-only">
                    {c.title}
                    <span data-state>{locked ? `, required by ${site}` : unavailable ? ", not accepted" : ""}</span>
                  </span>
                </span>
              </label>
            );
          })
        }
        <label class="chip" title="Avoid look-alike characters: 0 O 1 l I">
          <input type="checkbox" data-ambiguous />
          <span class="chip-face">
            <span aria-hidden="true"><small>no</small> 0O1l</span>
            <span class="sr-only">Avoid look-alike characters</span>
          </span>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="controls" data-panel="passphrase" hidden>
    <section class="card ctl">
      <div class="ctl-head">
        <label class="label" for="words">Words</label>
        <output for="words" data-words-value>5</output>
      </div>
      <input id="words" type="range" min={MIN_WORDS} max={MAX_WORDS} value="5" style="--pct: 16.7%" data-words />
      <div class="hints">
        <span data-words-min>{MIN_WORDS}</span>
        <span>min</span>
        <span aria-hidden="true">·</span>
        <button type="button" class="rec" data-recommend-words>recommended</button>
        <span data-words-max>{MAX_WORDS}</span>
      </div>
    </section>

    <fieldset class="card ctl tight">
      <legend class="label">Between words</legend>
      <div class="chips compact">
        {
          SEPARATORS.map((s, i) => (
            <label class="chip">
              <input type="radio" name="separator" value={s} checked={i === 0} data-separator />
              <span class="chip-face">
                <span aria-hidden="true">{separatorLabel(s)}</span>
                <span class="sr-only">{separatorName[s]}</span>
              </span>
            </label>
          ))
        }
      </div>
      <div class="switches">
        <label class="switch">
          <input type="checkbox" role="switch" data-capitalize />
          <span class="track" aria-hidden="true"></span>
          <span>Capitalize <span class="faint" data-note="capitalize"></span></span>
        </label>
        <label class="switch">
          <input type="checkbox" role="switch" data-number />
          <span class="track" aria-hidden="true"></span>
          <span>Add a number <span class="faint" data-note="number"></span></span>
        </label>
      </div>
    </fieldset>
  </div>
</div>

<script>
  import "@/scripts/generator";
</script>

<style>
  .generator {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .main {
    padding: 26px 30px;
  }

  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }

  .mode {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 0;
    border-radius: 999px;
    background: var(--pill);
  }

  .mode label {
    position: relative;
    display: block;
  }

  .mode input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .mode span {
    display: block;
    padding: 5px 13px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .mode input:checked + span {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .mode input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .meets {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--good-text);
  }

  .meets[hidden] {
    display: none;
  }

  .ck {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--good);
  }

  .ck svg {
    width: 10px;
    height: 10px;
    fill: none;
    stroke: var(--surface);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .result[hidden],
  .unsupported[hidden],
  .controls[hidden] {
    display: none;
  }

  .value {
    display: block;
    min-height: 1.25em;
    margin-bottom: 18px;
    font-family: var(--font-mono);
    font-size: 36px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
    color: var(--text);
  }

  .placeholder {
    color: var(--track);
  }

  .bars {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 5px;
    margin-bottom: 18px;
  }

  .bars i {
    height: 8px;
    border-radius: 999px;
    background: var(--track);
    transition: background 0.25s ease;
  }

  .bars[data-tone="weak"] i.on {
    background: var(--weak);
  }

  .bars[data-tone="fair"] i.on {
    background: var(--fair);
  }

  .bars[data-tone="good"] i.on {
    background: var(--good);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .strength {
    min-height: 1.5em;
  }

  .strength b {
    font-size: 15px;
    font-weight: 600;
  }

  .strength span {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-faint);
  }

  .actions {
    display: flex;
    gap: 8px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 46px;
    padding: 0 20px;
    border-radius: var(--radius);
    font-size: 16px;
    font-weight: 600;
    transition:
      background 0.15s ease,
      filter 0.15s ease;
  }

  .btn:disabled {
    cursor: default;
    opacity: 0.55;
  }

  .ghost {
    border: 1px solid var(--border);
    background: var(--surface);
  }

  .ghost:not(:disabled):hover {
    background: var(--hover);
  }

  .brand {
    min-width: 116px;
    background: var(--brand);
    color: var(--brand-ink);
  }

  .brand:not(:disabled):hover {
    filter: brightness(0.94);
  }

  .unsupported {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 18px;
    border-radius: var(--radius);
    background: var(--fair-soft);
  }

  .controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .ctl {
    min-width: 0;
    padding: 20px 22px;
  }

  fieldset.ctl {
    margin: 0;
  }

  fieldset.ctl legend {
    float: left;
    width: 100%;
    margin-bottom: 14px;
  }

  .ctl-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .ctl-head output {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
  }

  input[type="range"] {
    --fill: var(--slider);
    width: 100%;
    height: 18px;
    margin: 0 0 8px;
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
  }

  input[type="range"]::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--fill) 0 var(--pct), var(--track) var(--pct) 100%);
  }

  input[type="range"]::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    margin-top: -5px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 2px 6px rgba(26, 29, 46, 0.18),
      0 0 0 1px var(--border);
    -webkit-appearance: none;
    appearance: none;
  }

  input[type="range"]::-moz-range-track {
    height: 8px;
    border-radius: 999px;
    background: var(--track);
  }

  input[type="range"]::-moz-range-progress {
    height: 8px;
    border-radius: 999px;
    background: var(--fill);
  }

  input[type="range"]::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 2px 6px rgba(26, 29, 46, 0.18),
      0 0 0 1px var(--border);
  }

  .hints {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
  }

  /* Sets the slider to the recommended value. */
  .rec {
    padding: 0;
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }

  .rec:hover {
    color: var(--text);
  }

  .chips {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    position: relative;
  }

  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .chip input:disabled {
    cursor: not-allowed;
  }

  .chip-face {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 46px;
    padding: 0 14px;
    border-radius: var(--radius);
    background: var(--pill);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition:
      background 120ms,
      color 120ms;
  }

  .chip-face small {
    font-size: 11px;
    font-weight: 500;
  }

  .chips.compact .chip-face {
    height: 34px;
    min-width: 44px;
    padding: 0 12px;
  }

  /* Separators and two switches in the same height as the Length card. */
  fieldset.ctl.tight legend {
    margin-bottom: 6px;
  }

  .tight .switch {
    margin-top: 4px;
    line-height: 18px;
  }

  .chip input:checked + .chip-face {
    background: var(--on);
    color: var(--on-text);
  }

  .chip input:disabled:not(:checked) + .chip-face {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .chip input:focus-visible + .chip-face {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .chip :global(.lock) {
    display: none;
  }

  .chip[data-locked] :global(.lock) {
    display: block;
  }

  :global(.lock) {
    width: 11px;
    height: 11px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .switches {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }

  .switch {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    font-size: 13.5px;
    color: var(--text-muted);
    cursor: pointer;
  }

  .switch input {
    position: absolute;
    width: 30px;
    height: 18px;
    opacity: 0;
    cursor: pointer;
  }

  .switch input:disabled {
    cursor: not-allowed;
  }

  .track {
    position: relative;
    flex: none;
    width: 30px;
    height: 18px;
    border-radius: 999px;
    background: var(--track);
    transition: background 0.15s ease;
  }

  .track::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    transition: transform 0.15s ease;
  }

  .switch input:checked + .track {
    background: var(--slider);
  }

  .switch input:checked + .track::after {
    transform: translateX(12px);
  }

  .switch input:focus-visible + .track {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .switch input:disabled + .track {
    opacity: 0.6;
  }

  .faint {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (max-width: 760px) {
    .main {
      padding: 20px;
    }

    /* Its own line on phones, so a wider web font can't push it onto one later. */
    .top-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .value {
      font-size: 24px;
    }

    .foot {
      flex-direction: column;
      align-items: stretch;
    }

    .actions .btn {
      flex: 1;
    }

    .controls {
      grid-template-columns: minmax(0, 1fr);
    }

    /* All five character chips fit on one line with either font. */
    .chips:not(.compact) .chip-face {
      padding: 0 10px;
      font-size: 12px;
    }
  }
</style>
