---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Meter from "@/components/ui/Meter.astro";
import RangeField from "@/components/ui/RangeField.astro";
import Switch from "@/components/ui/Switch.astro";
import { shortName } from "@/data/types";
import { classNote } from "@/lib/describe";
import { clamp } from "@/lib/math";
import { DEFAULT_PASSPHRASE_OPTIONS, MAX_WORDS, MIN_WORDS, SEPARATORS } from "@/lib/passphrase";
import { DEFAULT_PASSWORD_OPTIONS, entropyBits, plan, type PasswordRules } from "@/lib/password";
import { meterForBits } from "@/lib/strength";

/** The password card under the banner and the options card under it; the default slot fills the column beside. */
interface Props {
  /** "github", or "any" for Any site: Recent shows its logo. */
  id: string;
  /** "GitHub", or "Any site". */
  site: string;
  rules: PasswordRules;
  /** No site rules to meet, so "Meets X's rules" never shows. */
  anySite?: boolean;
}

const { id, site, rules, anySite = false } = Astro.props;
const owner = shortName(site);
// Rendered with the script's starting options, so nothing jumps when it takes over.
const initial = plan(rules, DEFAULT_PASSWORD_OPTIONS);
const initialBits = entropyBits(initial);
const classes = [
  { name: "lower", sample: "abc", label: "Lowercase" },
  { name: "upper", sample: "ABC", label: "Uppercase" },
  { name: "digit", sample: "123", label: "Numbers" },
  { name: "symbol", sample: rules.symbols ? rules.symbols.slice(0, 3) : "#$&", label: "Symbols" },
] as const;
const separatorName: Record<string, string> = { "-": "Dash", ".": "Dot", _: "Underscore", " ": "Space", "": "None" };
const lockedHint = initial.locked.length > 0 || initial.unavailable.length > 0;
---

<!-- Driven by src/scripts/generator.ts, which finds everything by its data-* attribute. -->
<div
  class="generator"
  data-generator
  data-rules={JSON.stringify(rules)}
  data-site={site}
  data-id={id}
  data-owner={owner}
  data-any-site={anySite ? "" : undefined}
>
  <section class="password" aria-label={`${site} password`}>
    <div class="top">
      <span class="kind" data-kind>
        Your password
      </span>
      {/* Rendered up front so nothing shifts: generated passwords always meet the site's rules. */}
      <p class="meets" data-meets hidden={anySite}>
        <Icon name="check" size={16} weight={2.8} />
        Meets {owner}'s rules
      </p>
    </div>

    <div data-result>
      {/* <output> is a live region by default. Off, so dragging the slider doesn't read out every new password. */}
      <output class="value" aria-label="Generated password" aria-live="off" data-output>
        {/* Same width as the password, so the main content paints before the script runs and nothing moves when it does. */}
        <span class="placeholder" aria-hidden="true">
          {"•".repeat(initial.length)}
        </span>
        <noscript>Turn on JavaScript to generate a password.</noscript>
      </output>
      <p class="loading" data-loading hidden>
        <span class="spinner" aria-hidden="true"></span>
        Loading the word list · 25 KB, once
      </p>
      <div class="foot">
        <Meter
          meter={meterForBits(initialBits)}
          details={`${initial.length} characters · ${Math.floor(initialBits)} bits`}
        />
        <div class="actions">
          <Button icon aria-label="New password" data-regenerate disabled>
            <Icon name="refresh" size={22} />
          </Button>
          <Button variant="brand" class="copy" data-copy disabled>
            <Icon name="copy" size={22} class="when-ready" />
            <Icon name="check" size={22} weight={2.6} class="when-copied" />
            <span data-copy-label>Copy</span>
          </Button>
        </div>
      </div>
    </div>

    <div class="cant" data-unsupported hidden>
      <span class="cant-icon" aria-hidden="true">
        <Icon name="info" size={24} />
      </span>
      <b data-unsupported-title></b>
      <p data-unsupported-text></p>
      <Button variant="brand" data-use-password>
        Use a password
        <Icon name="arrow" />
      </Button>
    </div>

    <p class="copy-failed" data-copy-failed hidden>
      <Icon name="alert" size={18} />
      <span>
        Your browser blocked copying. Select the password and press{" "}
        <kbd class="keys">
          <span class="keys-mac">⌘C</span>
          <span class="keys-ctrl">Ctrl C</span>
        </kbd>
        .
      </span>
    </p>
    <p class="sr-only" role="status" data-status></p>
  </section>

  <div class="columns">
    <section class="card options" aria-label="Options">
      <fieldset class="kinds">
        <legend class="sr-only">Make a</legend>
        <label>
          <input type="radio" name="mode" value="password" checked />
          <span>Password</span>
        </label>
        <label>
          <input type="radio" name="mode" value="passphrase" />
          <span>Passphrase</span>
        </label>
      </fieldset>

      <div class="panel" data-panel="password">
        <RangeField
          name="length"
          label="Length"
          unit="characters"
          min={initial.minLength}
          max={initial.maxLength}
          value={initial.length}
          recommended={clamp(DEFAULT_PASSWORD_OPTIONS.length, initial.minLength, initial.maxLength)}
        />
        <fieldset class="field">
          <div class="field-head">
            <legend>Characters</legend>
            <span class="hint" hidden={!lockedHint} data-locked-hint>
              <Icon name="lock" size={14} />
              Locked by {owner}
            </span>
          </div>
          <div class="classes">
            {classes.map((c) => {
              const locked = initial.locked.includes(c.name);
              const unavailable = initial.unavailable.includes(c.name);
              return (
                <label
                  class="class"
                  data-chip={c.name}
                  data-lock={locked ? "required" : unavailable ? "unavailable" : undefined}
                >
                  <input type="checkbox" checked={!unavailable} disabled={locked || unavailable} data-class={c.name} />
                  <span class="state" aria-hidden="true">
                    <Icon name="check" size={14} weight={3} class="when-on" />
                    <Icon name="lock" size={13} weight={2.4} class="when-locked" />
                  </span>
                  <span class="glyph" aria-hidden="true">
                    {c.sample}
                  </span>
                  <span class="name">{c.label}</span>
                  <span class="note" data-note>
                    {classNote(c.name, initial, rules)}
                  </span>
                </label>
              );
            })}
          </div>
          <Switch hint="0 O 1 l I" data-ambiguous>
            Avoid look-alikes
          </Switch>
        </fieldset>
      </div>

      <div class="panel" data-panel="passphrase" hidden>
        <RangeField
          name="words"
          label="Words"
          unit="words"
          min={MIN_WORDS}
          max={MAX_WORDS}
          value={DEFAULT_PASSPHRASE_OPTIONS.words}
          recommended={DEFAULT_PASSPHRASE_OPTIONS.words}
        />
        <fieldset class="field">
          <div class="field-head">
            <legend>Between words</legend>
            <span class="hint" data-separators-hint hidden>
              <Icon name="lock" size={14} />
              Set by {owner}
            </span>
          </div>
          <div class="separators">
            {SEPARATORS.map((s) => (
              <label>
                <input
                  type="radio"
                  name="separator"
                  value={s}
                  checked={s === DEFAULT_PASSPHRASE_OPTIONS.separator}
                  data-separator
                />
                <span class:list={{ word: s === " " || s === "" }} aria-hidden="true">
                  {s === " " ? "Space" : s === "" ? "None" : s}
                </span>
                <span class="sr-only">{separatorName[s]}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="toggles">
          <Switch hint="Copper-Ladle" data-capitalize>
            Capitalise words
          </Switch>
          <Switch hint="amber4" data-number>
            Add a number
          </Switch>
        </div>
      </div>

      <p class="panel-note" data-panel-note hidden>
        Passphrases need room for at least four words. Switch back to a password for {owner}.
      </p>
    </section>

    <div class="aside">
      <slot />
    </div>
  </div>
</div>

<script>
  import "@/scripts/generator";
</script>

<style>
  /* The password card overlaps the banner's foot. */
  .password {
    position: relative;
    margin: -92px 28px 0;
    padding: 32px 36px;
    border: 1px solid var(--line);
    border-radius: 28px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 34px;
  }

  .kind {
    font-size: 16px;
    font-weight: 500;
    color: var(--muted);
  }

  .meets {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 14px 0 10px;
    border-radius: 999px;
    background: var(--good-soft);
    color: var(--good-text);
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
  }

  .value {
    display: block;
    margin: 18px 0 28px;
    font-family: var(--font-mono);
    font-size: 60px;
    font-weight: 700;
    line-height: 1.15;
    word-break: break-all;
  }

  /* Digits blue and symbols red, so the kinds of character stand apart, and 0 apart from O. */
  .value :global(.digit) {
    color: var(--digit);
  }

  .value :global(.symbol) {
    color: var(--sym);
  }

  /* A passphrase breaks between words, not inside them. */
  .value.phrase {
    font-size: 46px;
    word-break: normal;
    overflow-wrap: anywhere;
  }

  .placeholder {
    color: var(--line-2);
  }

  .loading {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 53px;
    margin: 18px 0 28px;
    font-size: 18px;
    color: var(--muted);
  }

  .spinner {
    width: 22px;
    height: 22px;
    border: 3px solid var(--track);
    border-top-color: var(--brand-ui);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .foot {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .actions {
    display: flex;
    gap: 12px;
  }

  .actions :global(.copy) {
    min-width: 172px;
  }

  .copy :global(.when-copied),
  .copy[data-copied] :global(.when-ready) {
    display: none;
  }

  .copy[data-copied] :global(.when-copied) {
    display: block;
  }

  .actions :global(.copy[data-copied]),
  .actions :global(.copy[data-copied]:hover) {
    background: var(--done-bg);
    color: var(--done-ink);
  }

  .copy-failed {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--fair-soft);
    font-size: 15px;
  }

  .copy-failed :global(.icon) {
    color: var(--fair-text);
  }

  .cant {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px 16px;
    margin-top: 20px;
    padding: 22px;
    border-radius: 20px;
    background: var(--sunk);
  }

  .cant-icon {
    display: grid;
    grid-row: span 2;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 16px;
    background: var(--fair-soft);
    color: var(--fair-text);
  }

  .cant b {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .cant p {
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .cant :global(.btn) {
    grid-column: 2;
    justify-self: start;
    margin-top: 14px;
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px;
    align-items: start;
    margin-top: 28px;
  }

  .aside {
    display: grid;
    gap: 24px;
  }

  fieldset {
    min-width: 0;
    border: 0;
  }

  /* Password / Passphrase: two radios drawn as a segmented control. */
  .kinds {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4px;
    padding: 5px;
    border-radius: 18px;
    background: var(--sunk);
  }

  .kinds label {
    position: relative;
  }

  .kinds input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .kinds span {
    display: grid;
    place-items: center;
    height: 48px;
    border-radius: 14px;
    font-size: 17px;
    font-weight: 500;
    color: var(--ink-2);
  }

  .kinds input:checked + span {
    background: var(--raise);
    color: var(--ink);
    box-shadow: var(--lift);
  }

  .kinds input:focus-visible + span {
    outline: 2.5px solid var(--focus);
    outline-offset: 2px;
  }

  .panel > :global(*),
  .panel-note {
    margin-top: 30px;
  }

  .panel-note {
    color: var(--ink-2);
  }

  .field-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  legend {
    float: left;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .hint {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
  }

  .classes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin-bottom: 16px;
  }

  /* A checkbox drawn as a tile: the real input sits invisibly over it, so it keeps native focus and clicks. */
  .class {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 116px;
    padding: 14px 14px 12px;
    border: 2px solid var(--line-2);
    border-radius: 18px;
    background: var(--surface);
    cursor: pointer;
    transition:
      background 0.15s,
      border-color 0.15s;
  }

  .class:hover {
    background: var(--hover);
  }

  .class input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
  }

  .class:has(:focus-visible) {
    outline: 2.5px solid var(--focus);
    outline-offset: 2px;
  }

  .state {
    position: absolute;
    top: 12px;
    right: 12px;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 2px var(--sw-off);
  }

  .state :global(.icon) {
    display: none;
  }

  .glyph {
    margin-bottom: auto;
    font-family: var(--font-mono);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
  }

  .name {
    margin-top: 14px;
    font-size: 15px;
    font-weight: 500;
  }

  .note {
    font-size: 13px;
    line-height: 1.3;
    color: var(--muted);
  }

  .class:not(:has(:checked)) .glyph {
    color: var(--muted);
  }

  .class:has(:checked) {
    border-color: var(--brand-ui);
    background: color-mix(in srgb, var(--brand-ui) 8%, var(--surface));
  }

  .class:has(:checked) .state {
    background: var(--brand-ui);
    color: var(--brand-ui-ink);
    box-shadow: none;
  }

  .class:has(:checked):not([data-lock]) .state :global(.when-on),
  .class[data-lock] .state :global(.when-locked) {
    display: block;
  }

  .class[data-lock],
  .class[data-lock] input {
    cursor: default;
  }

  .class[data-lock="unavailable"] {
    border-style: dashed;
    background: var(--sunk);
  }

  .class[data-lock="unavailable"] .glyph {
    text-decoration: line-through;
  }

  .class[data-lock="unavailable"] .state {
    box-shadow: none;
    color: var(--muted);
  }

  .separators {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 8px;
  }

  .separators label {
    position: relative;
  }

  .separators input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .separators input:disabled {
    cursor: not-allowed;
  }

  .separators span:not(.sr-only) {
    display: grid;
    place-items: center;
    height: 52px;
    border: 2px solid var(--line-2);
    border-radius: 14px;
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 700;
  }

  .separators .word {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
  }

  .separators input:checked + span {
    border-color: var(--brand-ui);
    background: color-mix(in srgb, var(--brand-ui) 8%, var(--surface));
  }

  .separators input:disabled + span {
    border-style: dashed;
    background: var(--sunk);
    color: var(--muted);
    text-decoration: line-through;
  }

  .separators input:focus-visible + span {
    outline: 2.5px solid var(--focus);
    outline-offset: 2px;
  }

  .toggles {
    display: grid;
    gap: 12px;
  }

  @media (max-width: 960px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 700px) {
    .password {
      margin: -42px 8px 0;
      padding: 18px 20px 20px;
      border-radius: 24px;
    }

    /* The "Meets" pill says enough on a phone. */
    .top:has(.meets:not([hidden])) .kind {
      display: none;
    }

    .kind {
      font-size: 15px;
    }

    .meets {
      height: 30px;
      padding: 0 12px 0 8px;
      font-size: 14px;
    }

    .value {
      margin: 10px 0 14px;
      font-size: 27px;
    }

    .value.phrase {
      font-size: 22px;
    }

    .loading {
      height: 51px;
      margin: 10px 0 14px;
      font-size: 16px;
    }

    .foot {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding-top: 16px;
    }

    .actions :global(.copy) {
      flex: 1;
      min-width: 0;
    }

    .cant {
      grid-template-columns: minmax(0, 1fr);
      padding: 18px;
    }

    .cant-icon {
      grid-row: auto;
      margin-bottom: 6px;
    }

    .cant :global(.btn) {
      grid-column: 1;
      justify-self: stretch;
    }

    .columns {
      gap: 16px;
      margin-top: 16px;
    }

    .aside {
      gap: 16px;
    }

    .classes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .class {
      min-height: 108px;
    }

    .separators {
      gap: 6px;
    }

    .separators span:not(.sr-only) {
      height: 48px;
      font-size: 17px;
    }

    .separators .word {
      font-size: 13px;
    }
  }
</style>
