---
import Button from "@/components/ui/Button.astro";
import RangeField from "@/components/ui/RangeField.astro";
import StrengthBars from "@/components/ui/StrengthBars.astro";
import Switch from "@/components/ui/Switch.astro";
import { shortName } from "@/data/types";
import { DEFAULT_SYMBOLS } from "@/lib/charsets";
import { chipText } from "@/lib/describe";
import { DEFAULT_PASSPHRASE_OPTIONS, MAX_WORDS, MIN_WORDS, SEPARATORS } from "@/lib/passphrase";
import { DEFAULT_PASSWORD_OPTIONS, entropyBits, plan, type PasswordRules } from "@/lib/password";
import { meterForBits } from "@/lib/strength";

interface Props {
  rules: PasswordRules;
  /** "GitHub", or "Any site". */
  site: string;
  /** No site rules to meet, so "Meets X's rules" never shows. */
  anySite?: boolean;
}

const { rules, site, anySite = false } = Astro.props;
const owner = shortName(site);
// Rendered with the script's starting options, so nothing jumps when it takes over.
const initial = plan(rules, DEFAULT_PASSWORD_OPTIONS);
const initialBits = entropyBits(initial);
const initialMeter = meterForBits(initialBits);
const symbols = rules.symbols || DEFAULT_SYMBOLS;
const classes = [
  { name: "lower", label: "a–z", title: "Lowercase letters" },
  { name: "upper", label: "A–Z", title: "Uppercase letters" },
  { name: "digit", label: "0–9", title: "Numbers" },
  { name: "symbol", label: symbols.length > 6 ? symbols.slice(0, 4) : symbols, title: `Symbols: ${symbols}` },
] as const;
const separatorName: Record<string, string> = { "-": "Dash", ".": "Dot", _: "Underscore", " ": "Space", "": "None" };
const separatorLabel = (s: string) => (s === " " ? "space" : s === "" ? "none" : s);
---

<!-- Driven by src/scripts/generator.ts, which finds everything by its data-* attribute. -->
<div
  class="generator"
  data-generator
  data-rules={JSON.stringify(rules)}
  data-site={site}
  data-owner={owner}
  data-any-site={anySite ? "" : undefined}
>
  <section class="card main" aria-label={`${site} password`}>
    <div class="top-row">
      <fieldset class="mode">
        <legend class="sr-only">Make a</legend>
        <label>
          <input type="radio" name="mode" value="password" checked />
          <span>Password</span>
        </label>
        <label>
          <input type="radio" name="mode" value="passphrase" />
          <span>Passphrase</span>
        </label>
      </fieldset>
      {/* Rendered up front so nothing shifts: generated passwords always meet the site's rules. */}
      <p class="meets" data-meets hidden={anySite}>
        <span class="ck" aria-hidden="true">
          <svg viewBox="0 0 16 16">
            <path d="M3.5 8.5l3 3 6-7"></path>
          </svg>
        </span>
        Meets {owner}'s rules
      </p>
    </div>

    <div class="result" data-result>
      {/* <output> is a live region by default. Off, so dragging the slider doesn't read out every new password. */}
      <output class="value" aria-label="Generated password" aria-live="off" data-output>
        {/* Same width as the password, so the main content paints before the script runs and nothing moves when it does. */}
        <span class="placeholder" aria-hidden="true">
          {"•".repeat(initial.length)}
        </span>
        <noscript>Turn on JavaScript to generate a password.</noscript>
      </output>
      <StrengthBars meter={initialMeter} />
      <div class="foot">
        <p class="strength">
          <b data-level>{initialMeter.label}</b>
          <span data-details>
            {initial.length} characters · {Math.floor(initialBits)} bits
          </span>
        </p>
        <div class="actions">
          <Button class="action" data-regenerate disabled>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 11a8 8 0 1 0-2.3 5.7"></path>
              <path d="M20 4v7h-7"></path>
            </svg>
            New
          </Button>
          <Button variant="brand" class="action copy" data-copy disabled>
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2"></rect>
              <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
            </svg>
            <span data-copy-label>Copy</span>
          </Button>
        </div>
      </div>
    </div>

    <div class="unsupported" data-unsupported hidden>
      <p data-unsupported-text></p>
      <Button data-use-password>Use a password</Button>
    </div>
    <p class="sr-only" role="status" data-status></p>
  </section>

  <div class="controls" data-panel="password">
    <section class="card ctl">
      <RangeField name="length" label="Length" min={initial.minLength} max={initial.maxLength} value={initial.length} />
    </section>

    <fieldset class="card ctl">
      <legend class="label">Characters</legend>
      <div class="chips">
        {classes.map((c) => {
          const locked = initial.locked.includes(c.name);
          const unavailable = initial.unavailable.includes(c.name);
          const text = chipText(c.title, c.name, initial, owner);
          return (
            <label
              class="chip"
              title={text.title}
              data-title={c.title}
              data-chip={c.name}
              data-locked={locked ? "" : undefined}
            >
              <input type="checkbox" checked={!unavailable} disabled={locked || unavailable} data-class={c.name} />
              <span class="chip-face">
                <svg class="lock" viewBox="0 0 16 16" aria-hidden="true">
                  <rect x="3.5" y="7" width="9" height="6.5" rx="1.5" />
                  <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" />
                </svg>
                <span aria-hidden="true">{c.label}</span>
                <span class="sr-only">
                  {c.title}
                  <span data-state>{text.state}</span>
                </span>
              </span>
            </label>
          );
        })}
        <label class="chip" title="Avoid look-alike characters: 0 O 1 l I">
          <input type="checkbox" data-ambiguous />
          <span class="chip-face">
            <span aria-hidden="true">
              <small>no</small> 0O1l
            </span>
            <span class="sr-only">Avoid look-alike characters</span>
          </span>
        </label>
      </div>
    </fieldset>
  </div>

  <div class="controls" data-panel="passphrase" hidden>
    <section class="card ctl">
      <RangeField name="words" label="Words" min={MIN_WORDS} max={MAX_WORDS} value={DEFAULT_PASSPHRASE_OPTIONS.words} />
    </section>

    <fieldset class="card ctl tight">
      <legend class="label">Between words</legend>
      <div class="chips compact">
        {SEPARATORS.map((s) => (
          <label class="chip">
            <input
              type="radio"
              name="separator"
              value={s}
              checked={s === DEFAULT_PASSPHRASE_OPTIONS.separator}
              data-separator
            />
            <span class="chip-face">
              <span aria-hidden="true">{separatorLabel(s)}</span>
              <span class="sr-only">{separatorName[s]}</span>
            </span>
          </label>
        ))}
      </div>
      <div class="switches">
        <Switch data-capitalize>
          Capitalize <span class="faint" data-note="capitalize"></span>
        </Switch>
        <Switch data-number>
          Add a number <span class="faint" data-note="number"></span>
        </Switch>
      </div>
    </fieldset>
  </div>
</div>

<script>
  import "@/scripts/generator";
</script>

<style>
  .generator {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .main {
    padding: 26px 30px;
  }

  .top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }

  /* Password / Passphrase: two radios drawn as a segmented control. */
  .mode {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    border: 0;
    border-radius: 999px;
    background: var(--pill);
  }

  .mode label {
    position: relative;
    display: block;
  }

  .mode input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .mode span {
    display: block;
    padding: 5px 13px;
    border-radius: 999px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .mode input:checked + span {
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
  }

  .mode input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .meets {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--good-text);
  }

  .ck {
    display: grid;
    place-items: center;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--good);
  }

  .ck svg {
    width: 10px;
    height: 10px;
    fill: none;
    stroke: var(--surface);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .meets[hidden],
  .result[hidden],
  .unsupported[hidden],
  .controls[hidden] {
    display: none;
  }

  .result {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .value {
    display: block;
    min-height: 1.25em;
    font-family: var(--font-mono);
    font-size: 36px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0.02em;
    overflow-wrap: anywhere;
    color: var(--text);
  }

  .placeholder {
    color: var(--track);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .strength {
    min-height: 1.5em;
  }

  .strength b {
    font-size: 15px;
    font-weight: 600;
  }

  .strength span {
    margin-left: 8px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-faint);
  }

  .actions {
    display: flex;
    gap: 8px;
  }

  /* Wide enough for "Copied", so the buttons don't move when it changes. */
  .actions :global(.copy) {
    min-width: 116px;
  }

  .unsupported {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 18px;
    border-radius: var(--radius);
    background: var(--fair-soft);
  }

  .controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .ctl {
    min-width: 0;
    padding: 20px 22px;
  }

  fieldset.ctl {
    margin: 0;
  }

  fieldset.ctl legend {
    float: left;
    width: 100%;
    margin-bottom: 14px;
  }

  /* Separators and two switches in the same height as the Words card. */
  fieldset.ctl.tight legend {
    margin-bottom: 6px;
  }

  /* Checkboxes and radios drawn as chips: the real input sits invisibly on top. */
  .chips {
    clear: both;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .chip {
    position: relative;
  }

  .chip input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .chip input:disabled {
    cursor: not-allowed;
  }

  .chip-face {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 46px;
    padding: 0 14px;
    border-radius: var(--radius);
    background: var(--pill);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    transition:
      background 120ms,
      color 120ms;
  }

  .chip-face small {
    font-size: 11px;
    font-weight: 500;
  }

  .chips.compact .chip-face {
    height: 34px;
    min-width: 44px;
    padding: 0 12px;
  }

  .chip input:checked + .chip-face {
    background: var(--on);
    color: var(--on-text);
  }

  .chip input:disabled:not(:checked) + .chip-face {
    text-decoration: line-through;
    opacity: 0.6;
  }

  .chip input:focus-visible + .chip-face {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* Shown on classes the site requires. */
  .lock {
    display: none;
    width: 11px;
    height: 11px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chip[data-locked] .lock {
    display: block;
  }

  .switches {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 4px;
    line-height: 18px;
  }

  .faint {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }

  @media (max-width: 760px) {
    .main {
      padding: 20px;
    }

    /* Its own line on phones, so a wider web font can't push it onto one later. */
    .top-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .value {
      font-size: 24px;
    }

    .foot {
      flex-direction: column;
      align-items: stretch;
    }

    .actions :global(.action) {
      flex: 1;
    }

    .controls {
      grid-template-columns: minmax(0, 1fr);
    }

    /* All five character chips fit on one line with either font. */
    .chips:not(.compact) .chip-face {
      padding: 0 10px;
      font-size: 12px;
    }
  }
</style>
