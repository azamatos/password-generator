---
const onHealth = Astro.url.pathname.startsWith("/health");
const tabs = [
  { href: "/", label: "Generator", current: !onHealth, icon: "key" },
  { href: "/health/", label: "Health", current: onHealth, icon: "pulse" },
];
---

<!-- Persisted across page changes, so the tab pill can slide and Recent stays open where it was. -->
<header class="wrap header" transition:persist="header">
  <a class="logo" href="/">
    <span class="arrow" aria-hidden="true">➜</span>
    <span class="tilde" aria-hidden="true">~</span>
    <span class="name">pass.azamatos<span class="sr-only">, password generator home</span></span>
    <span class="cursor" aria-hidden="true"></span>
  </a>

  <nav class="tabs" aria-label="Main" data-tabs>
    <span class="pill" aria-hidden="true" data-pill></span>
    {
      tabs.map((tab) => (
        <a href={tab.href} aria-current={tab.current ? "page" : undefined}>
          {tab.icon === "key" ? (
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="8" cy="15" r="4" />
              <path d="M11 12l9-9M17 6l3 3M14 9l2 2" />
            </svg>
          ) : (
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 12h4l3-7 4 14 3-7h4" />
            </svg>
          )}
          <span class="tab-label">{tab.label}</span>
        </a>
      ))
    }
  </nav>

  <div class="right">
    <button class="recent-btn" type="button" aria-haspopup="dialog" data-recent-open>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
      <span class="tab-label">Recent</span>
      <span class="badge" data-recent-count hidden></span>
    </button>
  </div>

  <dialog class="drawer" aria-labelledby="recent-title" data-recent-dialog>
    <div class="drawer-head">
      <h2 id="recent-title">Recent</h2>
      <button type="button" class="small-btn" data-recent-close>Close</button>
    </div>
    <p class="note">Passwords you copied. They stay in this tab only and are gone when you reload or close it.</p>
    <p class="empty" data-recent-empty>Nothing yet. Copy a password and it shows up here.</p>
    <ol class="recent-list" data-recent-list></ol>
    <button type="button" class="small-btn clear" data-recent-clear hidden>Clear all</button>
    <p class="sr-only" role="status" data-recent-status></p>
  </dialog>
</header>

<script>
  import { clearRecent, onRecentChange, recentItems } from "@/scripts/recent";

  function ago(at: number): string {
    const minutes = Math.floor((Date.now() - at) / 60_000);
    if (minutes < 1) return "just now";
    if (minutes < 60) return `${minutes} min ago`;
    return `${Math.floor(minutes / 60)} h ago`;
  }

  // Enough to recognize a password without showing it to anyone looking over your shoulder.
  const mask = (value: string) => value.slice(0, 3) + "•".repeat(Math.min(Math.max(value.length - 3, 4), 12));

  function setupRecent(header: HTMLElement) {
    const open = header.querySelector<HTMLButtonElement>("[data-recent-open]")!;
    const dialog = header.querySelector<HTMLDialogElement>("[data-recent-dialog]")!;
    const $ = <T extends Element>(s: string) => dialog.querySelector<T>(s)!;
    const count = header.querySelector<HTMLElement>("[data-recent-count]")!;
    const list = $<HTMLOListElement>("[data-recent-list]");
    const empty = $<HTMLElement>("[data-recent-empty]");
    const clear = $<HTMLButtonElement>("[data-recent-clear]");
    const status = $<HTMLElement>("[data-recent-status]");

    const render = () => {
      const items = recentItems();
      count.hidden = items.length === 0;
      count.textContent = String(items.length);
      open.setAttribute("aria-label", items.length ? `Recent, ${items.length} copied` : "Recent");
      empty.hidden = items.length > 0;
      clear.hidden = items.length === 0;
      list.replaceChildren(
        ...items.map((item) => {
          const li = document.createElement("li");
          const text = document.createElement("div");
          const value = document.createElement("code");
          value.textContent = mask(item.value);
          const meta = document.createElement("span");
          meta.textContent = `${item.site} · ${ago(item.at)}`;
          text.append(value, meta);
          const button = document.createElement("button");
          button.type = "button";
          button.className = "small-btn";
          button.textContent = "Copy";
          button.setAttribute("aria-label", `Copy the ${item.site} password from ${ago(item.at)}`);
          button.addEventListener("click", async () => {
            try {
              await navigator.clipboard.writeText(item.value);
              button.textContent = "Copied";
              status.textContent = "Copied to the clipboard.";
            } catch {
              status.textContent = "Couldn't copy.";
            }
            setTimeout(() => (button.textContent = "Copy"), 2000);
          });
          li.append(text, button);
          return li;
        }),
      );
    };

    open.addEventListener("click", () => {
      render();
      dialog.showModal();
    });
    $<HTMLButtonElement>("[data-recent-close]").addEventListener("click", () => dialog.close());
    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
    clear.addEventListener("click", () => {
      clearRecent();
      status.textContent = "Recent passwords cleared.";
    });
    onRecentChange(render);
    render();
  }

  // Slides the dark pill under the current tab, like the original header.
  function movePill(header: HTMLElement, animate: boolean) {
    const nav = header.querySelector<HTMLElement>("[data-tabs]")!;
    const pill = header.querySelector<HTMLElement>("[data-pill]")!;
    const onHealth = location.pathname.startsWith("/health");
    const links = [...nav.querySelectorAll<HTMLAnchorElement>("a")];
    links.forEach((link) => {
      const current = (link.getAttribute("href") === "/health/") === onHealth;
      if (current) link.setAttribute("aria-current", "page");
      else link.removeAttribute("aria-current");
    });
    const active = links.find((l) => l.hasAttribute("aria-current"));
    if (!active) return;
    if (!animate) pill.style.transition = "none";
    pill.style.width = `${active.offsetWidth}px`;
    pill.style.transform = `translateX(${active.offsetLeft - 4}px)`;
    nav.classList.add("has-pill");
    if (!animate) requestAnimationFrame(() => requestAnimationFrame(() => (pill.style.transition = "")));
  }

  let ready = false;
  document.addEventListener("astro:page-load", () => {
    const header = document.querySelector<HTMLElement>(".header");
    if (!header) return;
    if (!ready) {
      ready = true;
      setupRecent(header);
      movePill(header, false);
      window.addEventListener("resize", () => movePill(header, false));
      return;
    }
    movePill(header, true);
  });
</script>

<style>
  .header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    user-select: none;
  }

  .arrow {
    color: var(--coral);
  }

  .tilde {
    color: var(--text-faint);
  }

  .name {
    letter-spacing: -0.02em;
  }

  .cursor {
    width: 7px;
    height: 13px;
    border-radius: 1.5px;
    background: var(--text);
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .tabs {
    position: relative;
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--pill);
  }

  .pill {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 0;
    height: calc(100% - 8px);
    border-radius: 999px;
    background: var(--on);
    transition:
      transform 280ms cubic-bezier(0.34, 1.2, 0.64, 1),
      width 280ms cubic-bezier(0.34, 1.2, 0.64, 1);
  }

  .tabs a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms;
  }

  .tabs a[aria-current="page"] {
    color: var(--on-text);
  }

  /* Until the script places the pill, the current tab carries its own background. */
  .tabs:not(.has-pill) a[aria-current="page"] {
    background: var(--on);
  }

  .right {
    justify-self: end;
  }

  .recent-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
    transition: background 120ms;
  }

  .recent-btn:hover {
    background: var(--hover);
  }

  .badge {
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--coral);
    color: #2a0e07;
    font-size: 11px;
    font-weight: 700;
  }

  .badge[hidden] {
    display: none;
  }

  /* Recent panel, sliding in from the right. */
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(380px, 100vw);
    height: 100%;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 22px;
    border: 0;
    border-left: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
  }

  .drawer[open] {
    display: flex;
    flex-direction: column;
    gap: 14px;
    animation: slide-in 0.2s ease-out;
  }

  .drawer::backdrop {
    background: var(--backdrop);
  }

  @keyframes slide-in {
    from {
      transform: translateX(24px);
      opacity: 0;
    }
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .drawer h2 {
    font-size: 18px;
    font-weight: 600;
  }

  .note,
  .empty {
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .empty[hidden],
  .clear[hidden] {
    display: none;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    list-style: none;
  }

  .recent-list :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .recent-list :global(code) {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .recent-list :global(span) {
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .small-btn,
  .recent-list :global(.small-btn) {
    flex: none;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 13.5px;
    font-weight: 600;
  }

  .small-btn:hover,
  .recent-list :global(.small-btn):hover {
    background: var(--hover);
  }

  .clear {
    align-self: flex-start;
  }

  @media (max-width: 760px) {
    .header {
      padding-top: 12px;
      padding-bottom: 12px;
      gap: 10px;
    }

    .logo {
      font-size: 13px;
    }

    .tabs a {
      padding: 7px 11px;
    }

    /* Icons only on phones; the labels stay for screen readers. */
    .tab-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .recent-btn {
      padding: 0 11px;
    }
  }
</style>
