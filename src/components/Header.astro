---
import Dialog from "@/components/ui/Dialog.astro";
import Icon from "@/components/ui/Icon.astro";
import Logo from "@/components/ui/Logo.astro";
import { sites } from "@/data/platforms";

// Generator is current on any site's page, Health on /health/, and neither on the 404 page.
const path = Astro.url.pathname;
const tabs = [
  { href: "/", label: "Generator", current: sites.some((site) => site.href === path) },
  { href: "/health/", label: "Health", current: path === "/health/" },
];
const themes = [
  { value: "system", label: "System", icon: "system" },
  { value: "light", label: "Light", icon: "sun" },
  { value: "dark", label: "Dark", icon: "moon" },
] as const;
---

<!--
  Persisted across page changes, with Recent and the site switcher inside, so Recent keeps its list. The current tab
  and site are marked by src/scripts/header.ts.
-->
<header class="wrap header" transition:persist="header" data-header>
  <a class="wordmark" href="/">
    <span class="arrow" aria-hidden="true">
      ➜
    </span>
    <span class="tilde" aria-hidden="true">
      ~
    </span>
    <span>
      pass.azamatos<span class="sr-only">, password generator home</span>
    </span>
    <span class="cursor" aria-hidden="true"></span>
  </a>

  <nav class="tabs" aria-label="Main" data-tabs>
    {tabs.map((tab) => (
      <a href={tab.href} aria-current={tab.current ? "page" : undefined}>
        {tab.label}
      </a>
    ))}
  </nav>

  <button type="button" class="recent" aria-label="Recent" aria-haspopup="dialog" data-recent-open>
    <Icon name="clock" size={19} />
    <span class="recent-label" aria-hidden="true">
      Recent
    </span>
    <span class="badge" aria-hidden="true" data-recent-count hidden></span>
  </button>

  <fieldset class="themes">
    <legend class="sr-only">Theme</legend>
    {themes.map((theme) => (
      <label title={theme.label}>
        <input type="radio" name="theme" value={theme.value} checked={theme.value === "system"} />
        <Icon name={theme.icon} size={18} />
        <span class="sr-only">{theme.label}</span>
      </label>
    ))}
  </fieldset>
  {/* On phones the three become one button that steps through them. */}
  <button type="button" class="theme-step" aria-label="Theme: System. Switch to Light" data-theme-step>
    {themes.map((theme) => (
      <Icon name={theme.icon} class={`when-${theme.value}`} />
    ))}
  </button>

  <Dialog place="corner" aria-labelledby="recent-title" data-recent-dialog>
    <div class="recent-head">
      <h2 id="recent-title">Recent</h2>
      <button type="button" class="link" data-recent-clear hidden>
        Clear all
      </button>
      <button type="button" class="close" aria-label="Close" data-dialog-close>
        <Icon name="x" size={18} />
      </button>
    </div>
    <p class="recent-empty" data-recent-empty>
      Nothing yet. Passwords you copy show up here.
    </p>
    <ol class="recent-list" data-recent-list></ol>
    <p class="recent-foot">
      <Icon name="clock" size={16} />
      Kept in this tab only. Reloading or closing it clears the list.
    </p>
    <p class="sr-only" role="status" data-recent-status></p>
    <template data-any-logo>
      <Logo id="any" />
    </template>
    <template data-copy-icon>
      <Icon name="copy" size={16} />
    </template>
  </Dialog>

  <Dialog aria-label="Choose a site" data-sites-dialog>
    <label class="search">
      <Icon name="search" size={22} />
      <span class="sr-only">Search sites</span>
      <input
        type="search"
        placeholder={`Search ${sites.length} sites`}
        autocomplete="off"
        autofocus
        data-sites-search
      />
      <kbd aria-hidden="true">Esc</kbd>
    </label>
    <ul class="sites" data-sites-list>
      {sites.map((site) => (
        <li data-name={site.name.toLowerCase()}>
          <a href={site.href}>
            <span class="tile">
              <Logo id={site.id} />
            </span>
            <span class="name">{site.name}</span>
            <span class="summary">{site.summary}</span>
            <Icon name="check" size={18} weight={2.6} class="current" />
          </a>
        </li>
      ))}
      <li class="none" data-sites-none hidden>
        No site called “<span data-sites-query></span>”. Any site works everywhere.
      </li>
    </ul>
  </Dialog>
</header>

<script>
  import "@/scripts/header";
</script>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 84px;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-mono);
    font-size: 17px;
    white-space: nowrap;
  }

  .arrow {
    color: var(--sym);
  }

  .tilde {
    color: var(--muted);
  }

  /* Blinks four times, then stays; global.css stops it with reduced motion. */
  .cursor {
    width: 0.6em;
    height: 1.15em;
    margin-left: calc(-0.55em + 2px);
    background: currentColor;
    animation: blink 1s steps(1) 4;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .tabs {
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--sunk);
  }

  .tabs a {
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink-2);
  }

  .tabs a:hover {
    color: var(--ink);
  }

  .tabs a[aria-current="page"] {
    background: var(--raise);
    color: var(--ink);
    box-shadow: var(--lift);
  }

  .recent {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    margin-left: auto;
    padding: 0 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
    font-size: 15px;
    font-weight: 500;
  }

  .recent:hover,
  .theme-step:hover {
    background: var(--hover);
  }

  .badge {
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 99px;
    background: var(--ink);
    color: var(--bg);
    font: 700 12px/22px var(--font-mono);
    text-align: center;
  }

  /* System / Light / Dark: three radios drawn as a segmented control. */
  .themes {
    display: flex;
    gap: 2px;
    padding: 4px;
    border: 0;
    border-radius: 999px;
    background: var(--sunk);
  }

  .themes label {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
  }

  .themes label:hover {
    color: var(--ink);
  }

  .themes input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .themes label:has(:checked) {
    background: var(--raise);
    color: var(--ink);
    box-shadow: var(--lift);
  }

  .themes label:has(:focus-visible) {
    outline: 2.5px solid var(--focus);
    outline-offset: 2px;
  }

  .theme-step {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-2);
  }

  .theme-step :global(.icon) {
    display: none;
  }

  .theme-step[data-choice="system"] :global(.when-system),
  .theme-step[data-choice="light"] :global(.when-light),
  .theme-step[data-choice="dark"] :global(.when-dark) {
    display: block;
  }

  /* Recent */
  .recent-head {
    display: flex;
    flex: none;
    align-items: center;
    gap: 12px;
    padding: 16px 12px 8px 20px;
  }

  .recent-head h2 {
    flex: 1;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    color: var(--muted);
  }

  .close:hover {
    background: var(--hover);
    color: var(--ink);
  }

  .recent-empty {
    padding: 8px 20px 18px;
    color: var(--ink-2);
  }

  .recent-list {
    overflow: auto;
  }

  .recent-list :global(li) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px 10px 20px;
  }

  .recent-list :global(.tile) {
    width: 38px;
    height: 38px;
    border-radius: 12px;
  }

  .recent-list :global(.text) {
    display: grid;
    min-width: 0;
  }

  .recent-list :global(code) {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .recent-list :global(.meta) {
    font-size: 14px;
    color: var(--muted);
  }

  .recent-list :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    margin-left: auto;
    padding: 0 14px;
    border-radius: 12px;
    background: var(--sunk);
    font-size: 15px;
    font-weight: 500;
  }

  .recent-list :global(button:hover) {
    background: var(--hover);
  }

  .recent-foot {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
    margin-top: 6px;
    padding: 14px 20px;
    background: var(--sunk);
    font-size: 14px;
    color: var(--ink-2);
  }

  /* Site switcher */
  .search {
    display: flex;
    flex: none;
    align-items: center;
    gap: 12px;
    height: 64px;
    padding: 0 18px 0 20px;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }

  .search input {
    flex: 1;
    min-width: 0;
    height: 100%;
    outline: none;
    font-size: 18px;
    color: var(--ink);
  }

  .search input::placeholder {
    color: var(--muted);
  }

  .search input::-webkit-search-cancel-button {
    display: none;
  }

  /* The field is the first stop, so its row shows the focus. */
  .search:has(:focus-visible) {
    box-shadow: inset 0 -2.5px 0 var(--focus);
  }

  .sites {
    overflow: auto;
    padding: 8px;
  }

  .sites a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 6px 14px 6px 8px;
    border-radius: 14px;
  }

  .sites a:hover {
    background: var(--hover);
  }

  .sites a[aria-current="page"] {
    background: var(--sunk);
  }

  .sites .tile {
    width: 40px;
    height: 40px;
    border-radius: 12px;
  }

  .name {
    flex: 1;
    font-size: 16px;
    font-weight: 500;
  }

  .summary {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  /* Holds its place on every row, so the summaries line up. */
  .sites :global(.current) {
    color: var(--good-text);
    visibility: hidden;
  }

  .sites a[aria-current="page"] :global(.current) {
    visibility: visible;
  }

  .none {
    padding: 18px 14px;
    color: var(--ink-2);
  }

  /* Wordmark, Recent and the theme on one row; Generator and Health on a second. */
  @media (max-width: 700px) {
    .header {
      flex-wrap: wrap;
      gap: 8px;
      height: auto;
      padding-top: 10px;
      padding-bottom: 12px;
    }

    .wordmark {
      height: 44px;
      font-size: 14px;
    }

    .tabs {
      flex: 1 0 100%;
      order: 9;
    }

    .tabs a {
      flex: 1;
      justify-content: center;
      height: 44px;
    }

    .recent {
      justify-content: center;
      width: 44px;
      padding: 0;
    }

    .recent-label {
      display: none;
    }

    .badge {
      position: absolute;
      top: -4px;
      right: -6px;
    }

    .themes {
      display: none;
    }

    .theme-step {
      display: grid;
    }
  }
</style>
