---
const onHealth = Astro.url.pathname.startsWith("/health");
const tabs = [
  { href: "/", label: "Generator", current: !onHealth, icon: "key" },
  { href: "/health/", label: "Health", current: onHealth, icon: "pulse" },
];
---

<!-- Persisted across page changes, so the tab pill can slide and Recent stays open where it was. -->
<header class="wrap header" transition:persist="header" data-header>
  <a class="logo" href="/">
    <span class="arrow" aria-hidden="true">
      ➜
    </span>
    <span class="tilde" aria-hidden="true">
      ~
    </span>
    <span class="name">
      pass.azamatos<span class="sr-only">, password generator home</span>
    </span>
    <span class="cursor" aria-hidden="true"></span>
  </a>

  <nav class="tabs" aria-label="Main" data-tabs>
    <span class="pill" aria-hidden="true" data-pill></span>
    {tabs.map((tab) => (
      <a href={tab.href} aria-current={tab.current ? "page" : undefined}>
        {tab.icon === "key" ? (
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="8" cy="15" r="4" />
            <path d="M11 12l9-9M17 6l3 3M14 9l2 2" />
          </svg>
        ) : (
          <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 12h4l3-7 4 14 3-7h4" />
          </svg>
        )}
        <span class="tab-label">{tab.label}</span>
      </a>
    ))}
  </nav>

  <div class="right">
    <button class="recent-btn" type="button" aria-haspopup="dialog" data-recent-open>
      <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 7v5l3 2"></path>
      </svg>
      <span class="tab-label">Recent</span>
      <span class="badge" data-recent-count hidden></span>
    </button>
  </div>

  <dialog class="drawer" aria-labelledby="recent-title" data-recent-dialog>
    <div class="drawer-head">
      <h2 id="recent-title">Recent</h2>
      <button type="button" class="small-btn" data-recent-close>
        Close
      </button>
    </div>
    <p class="note">Passwords you copied. They stay in this tab only and are gone when you reload or close it.</p>
    <p class="empty" data-recent-empty>
      Nothing yet. Copy a password and it shows up here.
    </p>
    <ol class="recent-list" data-recent-list></ol>
    <button type="button" class="small-btn clear" data-recent-clear hidden>
      Clear all
    </button>
    <p class="sr-only" role="status" data-recent-status></p>
  </dialog>
</header>

<script>
  import "@/scripts/header";
</script>

<style>
  .header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    justify-self: start;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    user-select: none;
  }

  .arrow {
    color: var(--coral);
  }

  .tilde {
    color: var(--text-faint);
  }

  .name {
    letter-spacing: -0.02em;
  }

  .cursor {
    width: 7px;
    height: 13px;
    border-radius: 1.5px;
    background: var(--text);
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .tabs {
    position: relative;
    display: flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--pill);
  }

  .pill {
    position: absolute;
    top: 4px;
    left: 4px;
    width: 0;
    height: calc(100% - 8px);
    border-radius: 999px;
    background: var(--on);
    transition:
      transform 280ms cubic-bezier(0.34, 1.2, 0.64, 1),
      width 280ms cubic-bezier(0.34, 1.2, 0.64, 1);
  }

  .tabs a {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    transition: color 200ms;
  }

  .tabs a[aria-current="page"] {
    color: var(--on-text);
  }

  /* Until the script places the pill, the current tab carries its own background. */
  .tabs:not(.has-pill) a[aria-current="page"] {
    background: var(--on);
  }

  .right {
    justify-self: end;
  }

  .recent-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    box-shadow: var(--shadow);
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text);
    transition: background 120ms;
  }

  .recent-btn:hover {
    background: var(--hover);
  }

  .badge {
    display: grid;
    place-items: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--coral);
    color: var(--coral-ink);
    font-size: 11px;
    font-weight: 700;
  }

  .badge[hidden] {
    display: none;
  }

  /*
   * Recent panel, sliding in from the right and back out. The panel stays opaque the whole way, the
   * backdrop fades, and display/overlay transition too so closing animates before the dialog leaves
   * the top layer. Browsers without @starting-style open and close it instantly.
   */
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    /* A strip of backdrop stays visible on phones, so it reads as a panel you can tap away. */
    width: min(380px, 100vw - 40px);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0 0 0 auto;
    padding: 22px;
    border: 0;
    border-left: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    transform: translateX(100%);
    transition:
      transform 280ms cubic-bezier(0.32, 0.72, 0, 1),
      display 280ms allow-discrete,
      overlay 280ms allow-discrete;
  }

  .drawer[open] {
    display: flex;
    flex-direction: column;
    gap: 14px;
    transform: none;
  }

  .drawer::backdrop {
    background: transparent;
    transition:
      background 280ms ease,
      display 280ms allow-discrete,
      overlay 280ms allow-discrete;
  }

  .drawer[open]::backdrop {
    background: var(--backdrop);
  }

  @starting-style {
    .drawer[open] {
      transform: translateX(100%);
    }

    .drawer[open]::backdrop {
      background: transparent;
    }
  }

  /* Keep the page still behind the panel. The scrollbar gutter is always reserved (global.css), so nothing shifts. */
  :global(html:has(.drawer[open])) {
    overflow: hidden;
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .drawer h2 {
    font-size: 18px;
    font-weight: 600;
  }

  .note,
  .empty {
    font-size: 13.5px;
    color: var(--text-muted);
  }

  .empty[hidden],
  .clear[hidden] {
    display: none;
  }

  .recent-list {
    display: flex;
    flex-direction: column;
    list-style: none;
  }

  .recent-list :global(li) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .recent-list :global(code) {
    display: block;
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .recent-list :global(span) {
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .small-btn,
  .recent-list :global(.small-btn) {
    flex: none;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
    font-size: 13.5px;
    font-weight: 600;
  }

  .small-btn:hover,
  .recent-list :global(.small-btn):hover {
    background: var(--hover);
  }

  .clear {
    align-self: flex-start;
  }

  @media (max-width: 760px) {
    .header {
      padding-top: 12px;
      padding-bottom: 12px;
      gap: 10px;
    }

    .logo {
      font-size: 13px;
    }

    .tabs a {
      padding: 7px 11px;
    }

    /* Icons only on phones; the labels stay for screen readers. */
    .tab-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .recent-btn {
      padding: 0 11px;
    }
  }
</style>
