---
import { ANY, platforms } from "@/data/platforms";
import { shortSummary } from "@/lib/describe";
import { ANY_SITE } from "@/lib/password";

interface Props {
  current: string;
}

/** Shown before "+ N more" until the script measures how many fit next to the right column. */
const VISIBLE = 10;

const { current } = Astro.props;
const items = [
  { id: ANY.id, href: "/", name: ANY.name, short: ANY.short, summary: shortSummary(ANY_SITE) },
  ...platforms.map((p) => ({
    id: p.id,
    href: `/${p.id}/`,
    name: p.name,
    short: p.short,
    summary: shortSummary(p.rules),
  })),
];
const hidden = items.length - VISIBLE;
// Rendered in its final state so nothing jumps: open when the current platform is one of the hidden ones.
const expanded = items.findIndex((item) => item.id === current) >= VISIBLE;
---

<aside class="side" aria-label="Platforms" transition:persist="sidebar" data-sidebar data-visible={VISIBLE}>
  <p class="label head">Platforms · {platforms.length}</p>
  <label class="search">
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.5-3.5"></path>
    </svg>
    <span class="sr-only">Search platforms</span>
    <input type="search" placeholder="Search…" autocomplete="off" spellcheck="false" data-search />
    <kbd aria-hidden="true">⌘K</kbd>
  </label>
  <ul class:list={["list", { expanded }]} data-list>
    {items.map((item, i) => (
      <li data-name={item.name.toLowerCase()} hidden={i >= VISIBLE && !expanded}>
        <a href={item.href} aria-current={item.id === current ? "page" : undefined}>
          <span class="mono-tile" aria-hidden="true">
            {item.id === ANY.id ? (
              <svg class="any" viewBox="0 0 16 16">
                <path d="M8 2.5v11M3.2 5.25l9.6 5.5M12.8 5.25l-9.6 5.5" />
              </svg>
            ) : (
              item.short
            )}
          </span>
          <span class="meta">
            <span class="name">{item.name}</span>
            <span class="summary">{item.summary}</span>
          </span>
          <span class="dot" aria-hidden="true" />
        </a>
      </li>
    ))}
  </ul>
  <p class="none" data-none hidden>
    No platform matches. Try Any site.
  </p>
  <button type="button" class="more" aria-expanded={expanded ? "true" : "false"} data-more>
    {expanded ? "show less" : `+ ${hidden} more`}
  </button>
</aside>

<script>
  function setup(side: HTMLElement) {
    let visible = Number(side.dataset.visible);
    const list = side.querySelector<HTMLUListElement>("[data-list]")!;
    const search = side.querySelector<HTMLInputElement>("[data-search]")!;
    const items = [...list.querySelectorAll<HTMLLIElement>("li")];
    const more = side.querySelector<HTMLButtonElement>("[data-more]")!;
    const none = side.querySelector<HTMLElement>("[data-none]")!;
    let expanded = list.classList.contains("expanded");

    const render = () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      items.forEach((item, i) => {
        // While searching, every match shows; otherwise only the first ones until "more" is pressed.
        const show = q ? item.dataset.name!.includes(q) : expanded || i < visible;
        item.hidden = !show;
        if (show) shown++;
      });
      none.hidden = shown > 0;
      more.hidden = Boolean(q) || visible >= items.length;
      more.textContent = expanded ? "show less" : `+ ${items.length - visible} more`;
      more.setAttribute("aria-expanded", String(expanded));
      list.classList.toggle("expanded", expanded);
    };

    more.addEventListener("click", () => {
      expanded = !expanded;
      render();
      list.scrollTo({ top: expanded ? list.scrollHeight : 0, behavior: "smooth" });
    });
    search.addEventListener("input", render);
    search.addEventListener("keydown", (e) => {
      if (e.key === "Enter")
        items
          .find((i) => !i.hidden)
          ?.querySelector("a")
          ?.click();
      else if (e.key === "Escape") {
        search.value = "";
        render();
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key.toLowerCase() === "k" && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        search.focus();
        search.select();
      }
    });

    // The sidebar persists across page changes; only its current link changes.
    const markCurrent = () => {
      const path = location.pathname.replace(/\/?$/, "/");
      let index = -1;
      items.forEach((item, i) => {
        const link = item.querySelector("a")!;
        const current = link.getAttribute("href") === path;
        if (current) {
          link.setAttribute("aria-current", "page");
          index = i;
        } else link.removeAttribute("aria-current");
      });
      // Open the list when the current platform is one of the hidden ones.
      if (index >= visible && !expanded && !search.value) {
        expanded = true;
        render();
      }
      const link = items[index]?.querySelector("a");
      if (link && matchMedia("(max-width: 760px)").matches) link.scrollIntoView({ block: "nearest", inline: "center" });
      else if (link && expanded) link.scrollIntoView({ block: "nearest" });
    };

    // Show as many platforms as fit beside the right column; the rest go behind "+ N more".
    const desktop = matchMedia("(min-width: 761px)");
    const fit = () => {
      if (!desktop.matches) return;
      const row = items[0].offsetHeight + 2;
      const next = Math.max(3, Math.floor((list.clientHeight + 2) / row));
      if (next === visible) return;
      visible = next;
      render();
      markCurrent();
    };
    new ResizeObserver(fit).observe(list);

    render();
    fit();
    markCurrent();
    document.addEventListener("astro:page-load", markCurrent);
  }

  document.addEventListener("astro:page-load", () => {
    const side = document.querySelector<HTMLElement>("[data-sidebar]");
    if (side && !side.dataset.ready) {
      side.dataset.ready = "true";
      setup(side);
    }
  });
</script>

<style>
  /* contain: size keeps the list out of the row height, so the sidebar takes the right column's height. */
  .side {
    display: flex;
    flex-direction: column;
    min-width: 0;
    contain: size;
  }

  .head {
    margin-bottom: 12px;
    padding: 0 6px;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    padding: 9px 12px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text-faint);
    transition:
      border-color 120ms,
      box-shadow 120ms;
  }

  .search:focus-within {
    border-color: var(--border-strong);
    box-shadow: 0 0 0 3px var(--pill);
  }

  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: none;
    font-size: 14px;
    color: var(--text);
  }

  .search input::placeholder {
    color: var(--text-faint);
  }

  .search input::-webkit-search-cancel-button {
    display: none;
  }

  kbd {
    padding: 2px 5px;
    border-radius: 4px;
    background: var(--pill);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-faint);
  }

  /* The original 515px list, shorter on small screens; the scrollbar sits in the 8px gutter, clear of the items. */
  /* Fills the space down to "+ N more"; the scrollbar sits in the 8px gutter, clear of the items. */
  .list {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-height: 0;
    margin-right: -8px;
    padding-right: 8px;
    overflow: hidden;
    list-style: none;
  }

  .list.expanded {
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .list::-webkit-scrollbar {
    width: 4px;
  }

  .list::-webkit-scrollbar-thumb {
    border-radius: 99px;
    background: var(--border);
  }

  .list li[hidden] {
    display: none;
  }

  .list a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border: 1px solid transparent;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.1s;
  }

  .list a:hover {
    background: var(--hover);
  }

  .list a[aria-current="page"] {
    border-color: var(--border);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .any {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .meta {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    line-height: 1.25;
  }

  .name {
    font-size: 13px;
    font-weight: 600;
  }

  .summary {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--text-faint);
    white-space: nowrap;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  [aria-current="page"] .dot {
    background: var(--coral);
  }

  .none {
    padding: 6px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .none[hidden],
  .more[hidden] {
    display: none;
  }

  .more {
    width: 100%;
    margin-top: 12px;
    padding: 8px 10px;
    border: 1px dashed var(--border);
    border-radius: 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
    transition:
      background 120ms,
      color 120ms;
  }

  .more:hover {
    background: var(--hover);
    color: var(--text);
  }

  /* Phones: one horizontal row with every platform. */
  @media (max-width: 760px) {
    .side {
      contain: none;
    }

    .head,
    .search,
    .none,
    .more {
      display: none;
    }

    .list,
    .list.expanded {
      flex: none;
      flex-direction: row;
      gap: 6px;
      max-height: none;
      margin: 0 -16px;
      padding: 2px 16px 4px;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
    }

    .list li[hidden] {
      display: block;
    }

    .list a {
      padding: 6px 12px 6px 6px;
      border-color: var(--border);
      background: var(--surface);
      white-space: nowrap;
    }

    .list a[aria-current="page"] {
      border-color: var(--on);
    }

    .summary,
    .dot {
      display: none;
    }
  }
</style>
