---
import { position } from "@/lib/math";

/**
 * A slider with its value in large type, its min and max, and "Recommended" or "Reset to N" between them. A real range
 * input sits invisibly over the drawn track, so it keeps native keyboard and touch. bindRange (src/scripts/range.ts)
 * drives it.
 */
interface Props {
  /** The input's id, and how the script finds the field: data-range={name}. */
  name: string;
  label: string;
  /** After the value: "characters", "words". */
  unit: string;
  min: number;
  max: number;
  value: number;
  recommended: number;
}

const { name, label, unit, min, max, value, recommended } = Astro.props;
---

<div class="field" data-range={name}>
  <div class="head">
    <label for={name}>{label}</label>
    <output for={name}>
      <span data-range-value>{value}</span>
      <small>{unit}</small>
    </output>
  </div>
  <div class="slider" style={`--at: ${position(value, min, max)}`} data-range-track>
    <div class="track">
      <i></i>
    </div>
    {/* Before the drawn thumb, so the thumb paints on top and shows the input's focus. */}
    <input id={name} type="range" min={min} max={max} value={value} data-range-input />
    <span class="thumb"></span>
  </div>
  <div class="ticks">
    <span data-range-min>{min}</span>
    <span class="rec" hidden={value !== recommended} data-range-is-recommended>
      Recommended
    </span>
    <button type="button" class="link" hidden={value === recommended} data-range-recommend>
      Reset to {recommended}
    </button>
    <span data-range-max>{max}</span>
  </div>
</div>

<style>
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  label {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  output {
    font-family: var(--font-mono);
    font-size: 34px;
    font-weight: 700;
    line-height: 1;
  }

  small {
    margin-left: 8px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
  }

  /* --at is where the value sits, 0 to 1; the thumb's 30 px stays inside the track at both ends. */
  .slider {
    position: relative;
    height: 32px;
  }

  .track {
    position: absolute;
    top: 11px;
    right: 0;
    left: 0;
    height: 10px;
    overflow: hidden;
    border-radius: 99px;
    background: var(--track);
  }

  .track i {
    display: block;
    width: calc(15px + (100% - 30px) * var(--at));
    height: 100%;
    background: var(--brand-ui);
  }

  .thumb {
    position: absolute;
    top: 1px;
    left: calc((100% - 30px) * var(--at));
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      inset 0 0 0 3px var(--brand-ui),
      0 2px 6px rgba(0, 0, 0, 0.18);
    pointer-events: none;
  }

  input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  input:focus-visible + .thumb {
    outline: 2.5px solid var(--focus);
    outline-offset: 2px;
  }

  .ticks {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }

  .rec {
    font-family: var(--font-sans);
    font-size: 14px;
  }
</style>
