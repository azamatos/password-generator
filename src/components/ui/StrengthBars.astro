---
import type { Meter } from "@/lib/strength";

/** Five bars, filled from `meter` when given, and by a script with showMeter (src/scripts/meter.ts). */
interface Props {
  meter?: Meter;
}

const { meter } = Astro.props;
---

<div class="bars" aria-hidden="true" data-bars data-tone={meter?.tone}>
  {Array.from({ length: 5 }, (_, i) => (
    <i class:list={{ on: meter && i < meter.bars }} />
  ))}
</div>

<style>
  .bars {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 5px;
  }

  .bars i {
    height: 8px;
    border-radius: 999px;
    background: var(--track);
    transition: background 0.25s ease;
  }

  .bars[data-tone="weak"] i.on {
    background: var(--weak);
  }

  .bars[data-tone="fair"] i.on {
    background: var(--fair);
  }

  .bars[data-tone="good"] i.on {
    background: var(--good);
  }
</style>
