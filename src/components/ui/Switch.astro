---
import type { HTMLAttributes } from "astro/types";

/** An on/off switch: a checkbox announced as a switch. The slot is its label; other attributes go on the input. */
type Props = Omit<HTMLAttributes<"input">, "type" | "role">;
---

<label class="switch">
  <input type="checkbox" role="switch" {...Astro.props} />
  <span class="track" aria-hidden="true"></span>
  <span>
    <slot />
  </span>
</label>

<style>
  .switch {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: var(--text-muted);
    cursor: pointer;
  }

  /* The real checkbox sits invisibly over the track, so it keeps native focus and clicks. */
  .switch input {
    position: absolute;
    width: 30px;
    height: 18px;
    opacity: 0;
    cursor: pointer;
  }

  .switch input:disabled {
    cursor: not-allowed;
  }

  .track {
    position: relative;
    flex: none;
    width: 30px;
    height: 18px;
    border-radius: 999px;
    background: var(--track);
    transition: background 0.15s ease;
  }

  .track::after {
    content: "";
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    transition: transform 0.15s ease;
  }

  .switch input:checked + .track {
    background: var(--slider);
  }

  .switch input:checked + .track::after {
    transform: translateX(12px);
  }

  .switch input:focus-visible + .track {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .switch input:disabled + .track {
    opacity: 0.6;
  }
</style>
