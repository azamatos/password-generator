---
import { ClientRouter } from "astro:transitions";
import { getPlatformById } from "@/shared/utils/platforms";

interface Props {
  platformId: string;
}

const { platformId } = Astro.props;
const platform = getPlatformById(platformId);

const title = `${platform?.name ?? platformId} Password Generator — azamatos`;
const description = platform?.description ?? `Generate a secure password for ${platformId}.`;
const canonicalURL = Astro.url.href;
const ogImageURL = `${Astro.site}og/${platformId}.png`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: `${platform?.name} Password Generator`,
  url: canonicalURL,
  description,
  applicationCategory: "SecurityApplication",
  operatingSystem: "All",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  author: {
    "@type": "Person",
    name: "Azamat Jorayev",
    url: "https://azamatos.com",
  },
};
---

<html lang="en">
  <head>
    <ClientRouter />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>

    <!-- SEO -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content={`${platform?.name} password generator, secure password, strong password, ${platform?.name} security`}
    />
    <meta name="author" content="Azamat Jorayev" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#f7f0e1" />

    <!-- OPEN GRAPH -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Password Generator" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- TWITTER -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:creator" content="@azamatos" />

    <!-- FAVICONS -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="azamatos" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-KP23ZVYVC0"></script>
    <script>
      declare global {
        interface Window {
          dataLayer: unknown[];
          gtag: (...args: unknown[]) => void;
        }
      }

      window.dataLayer = window.dataLayer || [];
      window.gtag = (...args: unknown[]) => window.dataLayer.push(args);

      window.gtag("js", new Date());
      window.gtag("config", "G-KP23ZVYVC0");

      document.addEventListener("astro:page-load", () => {
        window.gtag("config", "G-KP23ZVYVC0", { page_path: window.location.pathname });
      });
    </script>
  </head>

  <body>
    <main transition:animate="fade">
      <pass-app-header transition:persist="header"></pass-app-header>
      <slot />
    </main>
    <ui-toast-provider transition:persist="toast"></ui-toast-provider>
  </body>
</html>

<script>
  import "@components/app-header";
  import "@widgets/toast";
</script>

<style is:global>
  @import "@/styles/global.css";
</style>
