---
import Banner from "@/components/Banner.astro";
import OtherSites from "@/components/OtherSites.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found · pass.azamatos" description="This page doesn't exist." noindex>
  <div class="wrap">
    <Banner long eyebrow="404" title="No page at this address" icon="search">
      The link may be old or mistyped. Every site's generator is listed below.
    </Banner>
    <div class="actions">
      <Button variant="brand" href="/">
        Any site
        <Icon name="arrow" />
      </Button>
      <Button href="/health/">Health check</Button>
    </div>
    <OtherSites />
  </div>
</Base>

<style>
  /* Sits on the banner's foot, as the cards do on the other pages. */
  .actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: -88px 44px 0;
  }

  @media (max-width: 700px) {
    .actions {
      margin: -44px 18px 0;
    }
  }
</style>
