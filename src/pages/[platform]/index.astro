---
import PlatformLayout from "@/layouts/PlatformLayout.astro";
import { getAllPlatformIds } from "@/shared/utils/platforms";

export function getStaticPaths() {
  return getAllPlatformIds().map((id) => ({ params: { platform: id } }));
}

const { platform: platformId } = Astro.params;
---

<PlatformLayout platformId={platformId}>
  <pass-platform platformId={platformId}></pass-platform>
</PlatformLayout>

<script>
  import "@widgets/platform-page";
</script>
