---
import Button from "@/components/ui/Button.astro";
import StrengthBars from "@/components/ui/StrengthBars.astro";
import Switch from "@/components/ui/Switch.astro";
import Base from "@/layouts/Base.astro";
---

<Base
  title="Password Strength Check · pass.azamatos"
  description="See how long a password would take to guess and whether it has leaked. Checked in your browser; only five characters of its hash are sent, to Have I Been Pwned."
  ogImage="og/health.png"
>
  <div class="wrap page">
    <div class="head">
      <h1>How strong is yours?</h1>
      <p class="note">Runs in your browser · nothing is stored</p>
    </div>

    <div class="layout">
      <section class="card look" aria-labelledby="look-title">
        <h2 id="look-title" class="label">
          What we look at
        </h2>
        <dl>
          <div>
            <dt>Length</dt>
            <dd>Longer is stronger</dd>
          </div>
          <div>
            <dt>Words & names</dt>
            <dd>Dictionaries, l33t speak</dd>
          </div>
          <div>
            <dt>Patterns</dt>
            <dd>qwerty, 1234, dates, repeats</dd>
          </div>
          <div>
            <dt>Breaches</dt>
            <dd>Have I Been Pwned · k-anonymity</dd>
          </div>
        </dl>
      </section>

      <section class="card checker" aria-labelledby="check-title" data-health>
        <div class="checker-head">
          <h2 id="check-title" class="label">
            <label for="password">Check your password</label>
          </h2>
          <p class="note">Only 5 characters of a hash are sent</p>
        </div>

        <div class="input-row">
          <input
            id="password"
            type="password"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            maxlength="256"
            placeholder="Type or paste a password…"
            data-input
          />
          <button type="button" class="eye-btn" aria-label="Show password" aria-pressed="false" data-toggle>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="lid" d="M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12z"></path>
              <circle class="pupil" cx="12" cy="12" r="2.8"></circle>
              <path class="slash-gap" d="M4.5 4.5l15 15"></path>
              <path class="slash" d="M4.5 4.5l15 15"></path>
            </svg>
          </button>
        </div>

        <Switch checked data-leak-opt-in>
          Check if it has leaked
        </Switch>

        <p class="status" data-loading hidden>
          Loading the word lists, once…
        </p>

        <p class="status" data-failed hidden>
          Couldn't load the strength check. Check your connection, then reload the page.
        </p>

        <div class="results" aria-live="polite" data-results hidden>
          <div class="verdict">
            <b data-verdict></b>
            <span class="chip" data-leak-chip hidden>
              Leaked
            </span>
          </div>
          <StrengthBars />
          <dl class="times">
            <div>
              <dt>Guessed online, 10 tries a second</dt>
              <dd data-online></dd>
            </div>
            <div>
              <dt>From a leaked database, 10,000 a second</dt>
              <dd data-offline></dd>
            </div>
          </dl>
          <p class="leak" data-leak hidden></p>
          <p class="warning" data-warning hidden></p>
          <ul class="suggestions" data-suggestions></ul>
        </div>

        <noscript>
          <p class="status">Turn on JavaScript to check a password.</p>
        </noscript>

        <div class="actions">
          <Button variant="brand" href="/" class="stronger">
            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20 11a8 8 0 1 0-2.3 5.7"></path>
              <path d="M20 4v7h-7"></path>
            </svg>
            Generate a stronger one
          </Button>
          <Button data-clear>Clear</Button>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import "@/scripts/health";
</script>

<style>
  .page {
    padding-top: 24px;
  }

  .head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: 56px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .note {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }

  .layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }

  .look {
    padding: 22px;
  }

  .look dl {
    margin-top: 6px;
  }

  .look dl div {
    padding: 10px 0;
    border-top: 1px solid var(--border);
  }

  .look dl div:first-child {
    border-top: 0;
  }

  .look dt {
    font-size: 14px;
    font-weight: 600;
  }

  .look dd {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-faint);
  }

  .checker {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 26px 30px;
  }

  .checker-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .input-row {
    display: flex;
    gap: 8px;
  }

  input[type="password"],
  input[type="text"] {
    flex: 1;
    min-width: 0;
    height: 52px;
    padding: 0 16px;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 18px;
  }

  input[type="password"]:focus,
  input[type="text"]:focus {
    outline: none;
    border-color: var(--coral);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--coral) 18%, transparent);
  }

  input::placeholder {
    color: var(--text-faint);
  }

  /* Fixed square, so toggling never changes the row. The slash draws in when the password is hidden. */
  .eye-btn {
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-muted);
    transition:
      background 200ms ease,
      color 200ms ease;
  }

  .eye-btn:hover {
    background: var(--hover);
    color: var(--text);
  }

  .eye-btn[aria-pressed="true"] {
    background: var(--pill);
    color: var(--text);
  }

  .eye-btn svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .lid,
  .pupil,
  .slash {
    stroke: currentColor;
  }

  .pupil {
    transform-origin: 12px 12px;
    transform: scale(0.75);
    transition: transform 280ms cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  .slash,
  .slash-gap {
    stroke-dasharray: 22;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 280ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Cuts a gap in the eye where the slash crosses it. */
  .slash-gap {
    stroke: var(--surface);
    stroke-width: 4.5;
  }

  .eye-btn:hover .slash-gap {
    stroke: var(--hover);
  }

  .eye-btn[aria-pressed="true"] .slash,
  .eye-btn[aria-pressed="true"] .slash-gap {
    stroke-dashoffset: 22;
  }

  .eye-btn[aria-pressed="true"] .pupil {
    transform: scale(1);
  }

  .status {
    color: var(--text-muted);
  }

  .results {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .results[hidden],
  .chip[hidden] {
    display: none;
  }

  .verdict {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .verdict b {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .chip {
    padding: 4px 9px;
    border-radius: 999px;
    background: var(--weak-soft);
    color: var(--weak);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .times {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .times div {
    padding: 12px 14px;
    border-radius: var(--radius);
    background: var(--tile);
  }

  .times dt {
    font-size: 12.5px;
    color: var(--text-muted);
  }

  .times dd {
    font-size: 16px;
    font-weight: 600;
  }

  .leak,
  .warning {
    padding: 12px 14px;
    border-radius: var(--radius);
    font-size: 14.5px;
  }

  .leak[data-state="clean"] {
    background: var(--good-soft);
  }

  .leak[data-state="leaked"],
  .warning {
    background: var(--weak-soft);
  }

  .leak[data-state="checking"],
  .leak[data-state="error"] {
    background: var(--pill);
  }

  .suggestions {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 20px;
    font-size: 14.5px;
    color: var(--text-muted);
  }

  .suggestions:empty {
    display: none;
  }

  .actions {
    display: flex;
    gap: 8px;
  }

  .actions :global(.stronger) {
    flex: 1;
  }

  @media (max-width: 760px) {
    .page {
      padding-top: 14px;
    }

    .head {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    h1 {
      font-size: 34px;
    }

    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
    }

    .look {
      order: 2;
    }

    .checker {
      padding: 20px;
    }

    .checker-head {
      flex-direction: column;
      gap: 2px;
    }

    .times {
      grid-template-columns: 1fr;
    }
  }
</style>
